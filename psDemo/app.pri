# Windows：把 ICO 嵌进 exe，任务栏 / 资源管理器才显示应用图标
# （仅 setWindowIcon 往往只影响标题栏小图标，任务栏仍用 exe 默认窗体图标）
win32: RC_ICONS = resources/icons/ui/app-logo.ico
