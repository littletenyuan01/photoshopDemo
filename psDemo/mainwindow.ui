<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1440</width>
    <height>900</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>1024</width>
    <height>640</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>PhotoshopLite</string>
  </property>
  <property name="windowIcon">
   <iconset resource="resources.qrc">
    <normaloff>:/icons/ui/app-logo.png</normaloff>:/icons/ui/app-logo.png</iconset>
  </property>
  <widget class="QStackedWidget" name="mainStack">
   <!-- 0=workspacePage 工作区；1=homeScreen 主页。启动默认主页（对齐 PS Home） -->
   <property name="currentIndex">
    <number>1</number>
   </property>
   <widget class="QWidget" name="workspacePage">
    <layout class="QVBoxLayout" name="rootVerticalLayout">
    <property name="spacing">
     <number>0</number>
    </property>
    <property name="leftMargin">
     <number>0</number>
    </property>
    <property name="topMargin">
     <number>0</number>
    </property>
    <property name="rightMargin">
     <number>0</number>
    </property>
    <property name="bottomMargin">
     <number>0</number>
    </property>
    <item>
     <widget class="ToolOptionsBar" name="toolOptionsBar" native="true"/>
    </item>
    <item>
     <layout class="QHBoxLayout" name="workspaceLayout">
      <property name="spacing">
       <number>0</number>
      </property>
      <item>
       <widget class="ToolBox" name="toolBox" native="true"/>
      </item>
      <item>
       <widget class="CanvasWorkspace" name="canvasWorkspace" native="true"/>
      </item>
      <item>
       <!-- PS 式右侧栏：颜色/色板/渐变/图案 → 属性/调整/库 → 图层/通道/路径。
            用 QSplitter 而不是固定布局：三段高度**可拖动调节**（PS 的面板组之间
            也是这种拖动条），否则下面图层区会被上面两块按各自 sizeHint 挤扁。
            不折叠(childrenCollapsible=false) + 每段的 minimumHeight 兜底，
            拖到底也不会把某一块拖没（要隐藏请用「窗口」菜单）。
            窄栏宽度约束放在 splitter 上，三段共用，不必写三份。 -->
       <widget class="QSplitter" name="rightSplitter">
        <property name="minimumSize">
         <size>
          <width>240</width>
          <height>0</height>
         </size>
        </property>
        <property name="maximumSize">
         <size>
          <width>320</width>
          <height>16777215</height>
         </size>
        </property>
        <property name="orientation">
         <enum>Qt::Orientation::Vertical</enum>
        </property>
        <property name="handleWidth">
         <number>4</number>
        </property>
        <property name="childrenCollapsible">
         <bool>false</bool>
        </property>
        <property name="opaqueResize">
         <bool>true</bool>
        </property>
        <widget class="ColorsPanel" name="colorsPanel" native="true">
         <property name="minimumSize">
          <size>
           <width>0</width>
           <height>120</height>
          </size>
         </property>
        </widget>
        <widget class="PropertiesPanel" name="propertiesPanel" native="true">
         <property name="minimumSize">
          <size>
           <width>0</width>
           <height>120</height>
          </size>
         </property>
        </widget>
        <widget class="DockPanel" name="dockPanel" native="true">
         <property name="minimumSize">
          <size>
           <width>0</width>
           <height>160</height>
          </size>
         </property>
        </widget>
       </widget>
      </item>
     </layout>
    </item>
   </layout>
   </widget>
   <widget class="HomeScreen" name="homeScreen" native="true"/>
  </widget>
  <widget class="QMenuBar" name="menubar">
