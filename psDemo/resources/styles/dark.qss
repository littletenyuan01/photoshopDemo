/* photoshopDemo 暗色主题 — 对齐 PS/GIMP 深色工作区，保证左侧工具栏图标可见 */

QMainWindow, QDialog {
  background-color: #2b2b2b;
  color: #e8e8e8;
}

QWidget {
  color: #e8e8e8;
  background-color: transparent;
}

QMenuBar {
  background-color: #3c3c3c;
  color: #e8e8e8;
  border-bottom: 1px solid #1f1f1f;
}
QMenuBar::item:selected {
  background-color: #505050;
}
QMenu {
  background-color: #3c3c3c;
  color: #e8e8e8;
  border: 1px solid #222;
}
QMenu::item:selected {
  background-color: #2d5a8a;
}
QMenu::item:disabled {
  color: #888;
}

QStatusBar {
  background-color: #3c3c3c;
  color: #ccc;
}

QToolTip {
  background-color: #2a2a2a;
  color: #eee;
  border: 1px solid #555;
}

QScrollArea {
  background-color: transparent;
  border: none;
}

QListWidget {
  background-color: #333;
  border: 1px solid #222;
  alternate-background-color: #383838;
}
QListWidget::item:selected {
  background-color: #2d5a8a;
}

QSlider::groove:horizontal {
  height: 4px;
  background: #555;
}
QSlider::handle:horizontal {
  width: 12px;
  margin: -5px 0;
  background: #c0c0c0;
  border-radius: 6px;
}

QToolButton, QPushButton {
  background-color: #4a4a4a;
  color: #e8e8e8;
  border: 1px solid #2a2a2a;
  border-radius: 3px;
  padding: 3px 6px;
}
QToolButton:hover, QPushButton:hover {
  background-color: #5a5a5a;
}
QToolButton:checked {
  background-color: #2d5a8a;
  border-color: #4a90d9;
}
QToolButton:disabled, QPushButton:disabled {
  color: #777;
  background-color: #3a3a3a;
}

QLabel {
  color: #e0e0e0;
  background: transparent;
}

/* ---------------------------------------------------------------------------
   QSpinBox / QDoubleSpinBox（工程统一用 Qt 自带控件）

   只要给 SpinBox 写了 background/border/padding，Windows 样式表代理就会接管
   按钮绘制；若不显式指定 ::up-button / ::down-button 的 subcontrol-position，
   箭头会被排成左右两列，且左侧（加）经常点不到。

   这里强制右上 / 右下叠放，与原生 UpDownArrows 一致。
   --------------------------------------------------------------------------- */
QSpinBox, QDoubleSpinBox {
  background-color: #3c3c3c;
  color: #eee;
  border: 1px solid #222;
  border-radius: 3px;
  padding: 2px 18px 2px 6px; /* 右侧留给上下箭头列 */
  min-height: 22px;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
  subcontrol-origin: border;
  subcontrol-position: top right;
  width: 16px;
  border-left: 1px solid #222;
  border-bottom: 1px solid #1a1a1a;
  background-color: #454545;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  width: 16px;
  border-left: 1px solid #222;
  background-color: #454545;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
  background-color: #555;
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
  background-color: #3a3a3a;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
  image: url(:/icons/ui/spin-up.png);
  width: 9px;
  height: 6px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
  image: url(:/icons/ui/spin-down.png);
  width: 9px;
  height: 6px;
}
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
  image: url(:/icons/ui/spin-up-disabled.png);
}
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
  image: url(:/icons/ui/spin-down-disabled.png);
}

/* ===========================================================================
   右侧停靠面板外观 —— 三个面板共用同一套规则，集中在此避免每个 .ui 各抄一份：
     DockPanel       图层 / 通道 / 路径
     ColorsPanel     颜色 / 色板 / 渐变 / 图案
     PropertiesPanel 属性 / 调整 / 库

   【选择器为什么写类名】面板是 .ui 里「提升(promote)」出来的自定义控件。
   用实例名（QWidget#colorsPanel …）或属性选择器（*[psPanel] …）做**祖先**都匹配不上：
   这些信息是 setupUi 阶段才设上去的，而样式规则表在控件构造期就已定型。
   实测只有类名（ColorsPanel / PropertiesPanel / DockPanel）能稳定命中，
   且与实例名无关、改名不会静默失效。
   【第二坑】全局 QWidget 是 background: transparent，而透明区域在深色窗口里
   会露出**黑底**。所以面板根和每个 Tab 页都要显式给底色，不能指望它自己透出来。
   =========================================================================== */
DockPanel, ColorsPanel, PropertiesPanel, InfoPanel {
  background-color: #3a3a3a;
  border-left: 1px solid #222;
}
/* 选项栏根：全局 QWidget 透明会透出黑底，必须显式上色 */
ToolOptionsBar {
  background-color: #4a4a4a;
  border-bottom: 1px solid #2a2a2a;
}
/* 每个 Tab 页的容器（全局透明 → 必须显式上色，否则页面空白处是黑的） */
ColorsPanel QWidget#tabColor,
ColorsPanel QWidget#tabSwatches,
ColorsPanel QWidget#tabGradients,
ColorsPanel QWidget#tabPatterns,
PropertiesPanel QWidget#tabProperties,
PropertiesPanel QWidget#tabAdjust,
PropertiesPanel QWidget#tabLibraries,
InfoPanel QWidget#tabInfo {
  background-color: #3a3a3a;
}
QTabWidget#panelTabs::pane {
  border: none;
  background-color: #3a3a3a;
  top: -1px;
}
QTabWidget#panelTabs QTabBar::tab {
  background-color: #2e2e2e;
  color: #b8b8b8;
  border: none;
  padding: 6px 9px;
  margin-right: 1px;
  min-width: 42px;
}
QTabWidget#panelTabs QTabBar::tab:selected {
  background-color: #3a3a3a;
  color: #f0f0f0;
}
QTabWidget#panelTabs QTabBar::tab:hover:!selected {
  background-color: #353535;
  color: #ddd;
}
QToolButton#btnPanelMenu {
  font-size: 14px;
  font-weight: bold;
  color: #ddd;
  background: transparent;
  border: none;
  padding: 4px 8px;
}
QToolButton#btnPanelMenu:hover {
  background-color: #4e4e4e;
}
/* 右侧栏三段的拖动条（拖动调各段高度；太细会看不见，故给一条可悬停高亮的槽） */
QSplitter#rightSplitter::handle:vertical {
  height: 4px;
  background-color: #2b2b2b;
  border-top: 1px solid #222;
  border-bottom: 1px solid #444;
}
QSplitter#rightSplitter::handle:vertical:hover {
  background-color: #4e7ba8;
}
/* 面板 / 选项栏输入框：必须用类名祖先（见上文「选择器为什么写类名」）。
   全局 QWidget 是 transparent，不显式描边+底色时，数值会像贴在黑底上的纯文字。 */
ColorsPanel QLineEdit,
PropertiesPanel QLineEdit,
ToolOptionsBar QLineEdit {
  background-color: #2a2a2a;
  color: #f0f0f0;
  border: 1px solid #b0b0b0;
  border-radius: 2px;
  padding: 1px 4px;
  min-height: 18px;
  min-width: 32px;
}
ColorsPanel QLineEdit:focus,
PropertiesPanel QLineEdit:focus,
ToolOptionsBar QLineEdit:focus {
  border: 1px solid #6cb0e8;
  background-color: #222;
}
ColorsPanel QTreeWidget,
ColorsPanel QListWidget,
PropertiesPanel QListWidget {
  background-color: #333;
  border: 1px solid #222;
  outline: none;
}
ColorsPanel QTreeWidget::item,
ColorsPanel QListWidget::item,
PropertiesPanel QListWidget::item {
  padding: 2px;
}
ColorsPanel QTreeWidget::item:selected,
ColorsPanel QListWidget::item:selected,
PropertiesPanel QListWidget::item:selected {
  background-color: #2d5a8a;
}
/* 面板内的小工具按钮（底栏动作、折叠分区标题）——
   全局 QToolButton 是「有底有框」的按钮样，面板里要的是扁平线框图标 */
ColorsPanel QToolButton,
PropertiesPanel QToolButton {
  background: transparent;
  border: none;
  color: #ddd;
  padding: 2px 4px;
}
ColorsPanel QToolButton:hover,
PropertiesPanel QToolButton:hover {
  background-color: #4e4e4e;
}
/* 分区标题是 checkable 的 QToolButton，必须显式压掉全局的 :checked 蓝底 */
PropertiesPanel QToolButton#toggleTransform,
PropertiesPanel QToolButton#toggleAlign,
PropertiesPanel QToolButton#toggleTransform:checked,
PropertiesPanel QToolButton#toggleAlign:checked {
  background: transparent;
  border: none;
  color: #f0f0f0;
  font-weight: bold;
  padding: 4px 2px;
  text-align: left;
}
/* 属性页顶部的真实数据摘要（文档尺寸 / 活动图层名），弱化一档不抢焦点 */
PropertiesPanel QLabel#labelTarget {
  color: #9a9a9a;
  padding: 2px 0;
}

/* —— 信息面板（对照 PS Info）：四宫格分割线 + 底栏文案 —— */
InfoPanel QFrame#cellRgb,
InfoPanel QFrame#cellXy {
  border-right: 1px solid #2a2a2a;
}
InfoPanel QFrame#cellRgb,
InfoPanel QFrame#cellCmyk {
  border-bottom: 1px solid #2a2a2a;
}
InfoPanel QLabel#labelDocSize {
  color: #c8c8c8;
  padding: 6px 8px 2px 8px;
}
InfoPanel QLabel#labelToolHint {
  color: #a8a8a8;
  padding: 4px 8px 8px 8px;
}
InfoPanel QToolButton#btnRgbMode,
InfoPanel QToolButton#btnCmykMode,
InfoPanel QToolButton#btnXyMode,
InfoPanel QToolButton#btnWhMode {
  color: #b0b0b0;
  border: none;
  padding: 2px;
  margin-top: 2px;
}
InfoPanel QFrame#cornerSep {
  color: #555;
  max-width: 1px;
}

/* 颜色页主区由 HsvColorWell 自绘（二维色域 + 竖直色相），不再用 QSlider#hueSlider */
