  <property name="styleSheet">
   <string notr="true">/* 工具栏用中灰，避免过黑；与画布深灰区分开 */
QWidget#ToolBox,
QWidget#toolsHost,
QScrollArea#toolsScroll {
  background-color: #5a5a5a;
}
QScrollArea#toolsScroll > QWidget > QWidget {
  background-color: #5a5a5a;
}
QWidget#colorArea {
  background-color: #5a5a5a;
  border-top: 1px solid #6e6e6e;
}
QToolButton {
  background-color: transparent;
  color: #f0f0f0;
  border: 1px solid transparent;
  border-radius: 3px;
  padding: 2px;
  font-size: 11px;
}
QToolButton:hover { background-color: #6e6e6e; }
QToolButton:checked { background-color: #3d6ea0; border-color: #6aa8e0; }
QPushButton#fgButton, QPushButton#bgButton {
  border: 1px solid #333;
  border-radius: 2px;
}
QToolButton#swapColorsButton, QToolButton#defaultColorsButton {
  font-size: 9px;
  color: #eee;
  background-color: #6a6a6a;
}</string>
