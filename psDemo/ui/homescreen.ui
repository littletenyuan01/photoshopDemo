  <property name="styleSheet">
   <string notr="true">/* 对齐 PS Home 启动屏（暗色工作区） */
QWidget#HomeScreen {
  background-color: #1e1e1e;
  color: #e8e8e8;
}
QWidget#topBar {
  background-color: #252525;
  border-bottom: 1px solid #111;
}
QWidget#sideBar {
  background-color: #2a2a2a;
  border-right: 1px solid #111;
}
QPushButton#newFileButton,
QPushButton#openButton {
  background-color: #0d66d0;
  color: #ffffff;
  border: none;
  border-radius: 16px;
  padding: 8px 20px;
  font-size: 13px;
  font-weight: 600;
}
QPushButton#newFileButton:hover,
QPushButton#openButton:hover { background-color: #1473e6; }
QToolButton#homeNavButton {
  background-color: #3a3a3a;
  color: #eee;
  border: none;
  border-radius: 6px;
  padding: 8px 12px;
  text-align: left;
}
QToolButton#backButton, QToolButton#searchButton {
  background: transparent;
  border: none;
  color: #ccc;
  padding: 4px;
}
QToolButton#backButton:hover, QToolButton#searchButton:hover {
  background-color: #3a3a3a;
  border-radius: 4px;
}
QLabel#recentTitle {
  color: #fff;
  font-size: 28px;
  font-weight: 600;
}
QLineEdit#filterEdit {
  background-color: #333;
  border: 1px solid #222;
  border-radius: 3px;
  padding: 4px 8px;
  color: #eee;
  min-height: 22px;
}
QComboBox#sortCombo {
  background-color: #333;
  border: 1px solid #222;
  border-radius: 3px;
  padding: 3px 8px;
  color: #eee;
  min-height: 22px;
}
QFrame#recentCard {
  background-color: #2a2a2a;
  border: 1px solid #3a3a3a;
  border-radius: 4px;
}
QLabel#cardThumb {
  background-color: #f5f5f5;
  border: 1px solid #555;
}
QToolButton#viewListButton, QToolButton#viewGridButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  padding: 4px;
  color: #ccc;
}
QToolButton#viewGridButton:checked {
  background-color: #3a3a3a;
  border-color: #555;
}
</string>
