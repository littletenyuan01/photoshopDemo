  <property name="maximumSize">
   <size>
    <width>16777215</width>
    <height>46</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>工具选项</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget#ToolOptionsBar {
  background-color: #4a4a4a;
  border-bottom: 1px solid #2a2a2a;
}
QWidget#ToolOptionsBar QLabel { color: #e8e8e8; }
QWidget#ToolOptionsBar QComboBox,
QWidget#ToolOptionsBar QSpinBox,
QWidget#ToolOptionsBar QFontComboBox {
  background-color: #3a3a3a;
  color: #eee;
  border: 1px solid #222;
  padding: 1px 4px;
  min-height: 22px;
}
QWidget#ToolOptionsBar QComboBox::drop-down { border: none; width: 16px; }
QWidget#ToolOptionsBar QCheckBox { color: #e8e8e8; spacing: 5px; }
/* 勾选框必须显式描边：暗色主题下全局 QWidget 背景是透明的，原生指示器会看不见 */
QWidget#ToolOptionsBar QCheckBox::indicator {
  width: 13px;
  height: 13px;
  border: 1px solid #c8c8c8;
  border-radius: 2px;
  background-color: #2e2e2e;
}
QWidget#ToolOptionsBar QCheckBox::indicator:hover { border-color: #ffffff; }
QWidget#ToolOptionsBar QCheckBox::indicator:checked {
  border: 1px solid #ffffff;
  background-color: #2e2e2e;
  image: url(:/icons/ui/check-white.png);
}
QWidget#ToolOptionsBar QToolButton {
  background-color: #3a3a3a;
  color: #eee;
  border: 1px solid #222;
  padding: 1px 4px;
}
QWidget#ToolOptionsBar QToolButton:hover { background-color: #4f4f4f; }
QWidget#ToolOptionsBar QToolButton:checked { background-color: #2d5a8a; }
/* 选项页的滚动容器：透明、无边框、细滚动条，避免出现一块浅色底 */
QWidget#ToolOptionsBar QScrollArea { background: transparent; border: none; }
QWidget#ToolOptionsBar QScrollArea > QWidget > QWidget { background: transparent; }
QWidget#ToolOptionsBar QScrollBar:horizontal {
  background: #3a3a3a;
  height: 8px;
  margin: 0;
}
QWidget#ToolOptionsBar QScrollBar::handle:horizontal {
  background: #6a6a6a;
  border-radius: 4px;
  min-width: 24px;
}
QWidget#ToolOptionsBar QScrollBar::add-line:horizontal,
QWidget#ToolOptionsBar QScrollBar::sub-line:horizontal { width: 0; }</string>
  </property>
  <layout class="QHBoxLayout" name="horizontalLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <property name="leftMargin">
    <number>8</number>
   </property>
   <property name="topMargin">
    <number>1</number>
   </property>
   <property name="rightMargin">
    <number>8</number>
   </property>
   <property name="bottomMargin">
    <number>1</number>
   </property>
   <item>
    <widget class="QLabel" name="toolNameLabel">
     <property name="minimumSize">
      <size>
       <width>120</width>
       <height>0</height>
      </size>
     </property>
     <property name="text">
      <string>移动工具</string>
     </property>
     <property name="styleSheet">
      <string notr="true">font-weight: bold;</string>
     </property>
    </widget>
   </item>

   <!-- 工具族选项页：切换工具时整页替换（对照 GIMP 的 gimp_tool_options_gui()）。
        套 QScrollArea：各页最小宽度不同（实测绘画页需 1038px），
        让它**保持自然宽度**、窗口不够宽时横向滚动 ——
        不能压缩 stack（早先设 QSizePolicy::Ignored，末尾 Expanding spacer 会吃掉所有
        空间，控件被压扁到只剩一位数字），也不能让 stack 撑大主窗口最小宽度。
        高度是固定值：QScrollArea 的 sizeHint 按字号推算（font-based，约 70px），
        故用 minimum/maximumSize 把它压回内容高度 + 滚动条。 -->
   <item>
    <widget class="QScrollArea" name="optionsScroll">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
       <horstretch>1</horstretch>
       <verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <property name="minimumSize">
      <size>
       <width>0</width>
       <height>26</height>
      </size>
     </property>
     <property name="maximumSize">
      <size>
       <width>16777215</width>
       <height>40</height>
      </size>
     </property>
     <property name="frameShape">
      <enum>QFrame::Shape::NoFrame</enum>
     </property>
     <property name="widgetResizable">
      <bool>true</bool>
     </property>
     <property name="horizontalScrollBarPolicy">
      <enum>Qt::ScrollBarPolicy::ScrollBarAsNeeded</enum>
     </property>
     <property name="verticalScrollBarPolicy">
      <enum>Qt::ScrollBarPolicy::ScrollBarAlwaysOff</enum>
     </property>
     <widget class="QWidget" name="optionsScrollHost">
      <layout class="QHBoxLayout" name="optionsScrollLayout">
       <property name="spacing">
        <number>0</number>
       </property>
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <!-- 关键：stack 左对齐、按 sizeHint 取宽 —— 否则 widgetResizable 会让它拿到
            整个视口宽度，Qt 布局再把多余空间平均分给各控件（下拉框/数字框默认可增长），
            结果在宽窗口下控件被拉得东一个西一个。 -->
       <item alignment="Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignVCenter">
        <widget class="QStackedWidget" name="optionsStack">

     <!-- 移动 -->
