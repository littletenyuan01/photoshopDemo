       <item><widget class="QToolButton" name="textColorButton"><property name="text"><string/></property><property name="toolTip"><string>文字颜色（UI 占位）</string></property><property name="minimumSize"><size><width>26</width><height>22</height></size></property></widget></item>
       <item><widget class="QLabel" name="textLineSpacingLabel"><property name="text"><string>行距</string></property></widget></item>
