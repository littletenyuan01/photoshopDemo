  <property name="styleSheet">
   <string notr="true">QDialog#CanvasSizeDialog {
  background-color: #4a4a4a;
  color: #e8e8e8;
}
QLabel { color: #e8e8e8; background: transparent; }
QLineEdit, QComboBox, QCheckBox {
  background-color: #3c3c3c;
  border: 1px solid #222;
  border-radius: 3px;
  padding: 3px 6px;
  color: #eee;
  min-height: 22px;
}
QCheckBox { border: none; background: transparent; }
QGroupBox {
  border: 1px solid #1a1a1a;
  border-radius: 4px;
  margin-top: 12px;
  padding-top: 8px;
  color: #e8e8e8;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 4px;
}
QPushButton#okButton {
  background-color: #0d66d0;
  color: #fff;
  border: none;
  border-radius: 3px;
  padding: 8px 22px;
  font-weight: 600;
  min-width: 72px;
}
QPushButton#okButton:hover { background-color: #1473e6; }
QPushButton#resetButton {
  background-color: #3a3a3a;
  color: #ddd;
  border: 1px solid #222;
  border-radius: 3px;
  padding: 8px 18px;
  min-width: 72px;
}
QToolButton#anchorTL, QToolButton#anchorTC, QToolButton#anchorTR,
QToolButton#anchorML, QToolButton#anchorMC, QToolButton#anchorMR,
QToolButton#anchorBL, QToolButton#anchorBC, QToolButton#anchorBR {
  background-color: #3a3a3a;
  border: 1px solid #222;
  border-radius: 2px;
  min-width: 28px;
  min-height: 28px;
  max-width: 28px;
  max-height: 28px;
  color: #ccc;
}
QToolButton#anchorTL:checked, QToolButton#anchorTC:checked, QToolButton#anchorTR:checked,
QToolButton#anchorML:checked, QToolButton#anchorMC:checked, QToolButton#anchorMR:checked,
QToolButton#anchorBL:checked, QToolButton#anchorBC:checked, QToolButton#anchorBR:checked {
  background-color: #0d66d0;
  border-color: #1473e6;
  color: #fff;
}
QFrame#extColorSwatch {
  background-color: #ffffff;
  border: 1px solid #111;
  min-width: 28px;
  max-width: 28px;
  min-height: 22px;
  max-height: 22px;
}
</string>
