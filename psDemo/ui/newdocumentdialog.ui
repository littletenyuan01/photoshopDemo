  <property name="styleSheet">
   <string notr="true">QDialog#NewDocumentDialog {
  background-color: #323232;
  color: #e8e8e8;
}
QLabel { color: #e8e8e8; background: transparent; }
QLineEdit, QComboBox {
  background-color: #3c3c3c;
  border: 1px solid #222;
  border-radius: 3px;
  padding: 3px 6px;
  color: #eee;
  min-height: 22px;
}
QTabWidget::pane {
  border: none;
  background: #2b2b2b;
}
QTabBar::tab {
  background: transparent;
  color: #aaa;
  padding: 8px 14px;
  border: none;
}
QTabBar::tab:selected {
  color: #fff;
  border-bottom: 2px solid #fff;
}
QFrame#presetClipboard,
QFrame#presetA4,
QFrame#presetDefault {
  background-color: #3a3a3a;
  border: 1px solid #2a2a2a;
  border-radius: 4px;
}
QFrame#presetClipboard[selected="true"],
QFrame#presetA4[selected="true"],
QFrame#presetDefault[selected="true"] {
  border: 2px solid #0d66d0;
}
QWidget#detailsPanel {
  background-color: #2b2b2b;
  border-left: 1px solid #1a1a1a;
}
QPushButton#createButton {
  background-color: #0d66d0;
  color: #fff;
  border: none;
  border-radius: 3px;
  padding: 8px 28px;
  font-weight: 600;
}
QPushButton#createButton:hover { background-color: #1473e6; }
QPushButton#closeButton {
  background: transparent;
  color: #ddd;
  border: 1px solid #555;
  border-radius: 3px;
  padding: 8px 24px;
}
QPushButton#closeButton:hover { background-color: #3a3a3a; }
QFrame#banner {
  background-color: #3a3a3a;
  border-radius: 4px;
}
QToolButton#orientLandscape, QToolButton#orientPortrait {
  background-color: #3c3c3c;
  border: 1px solid #222;
  border-radius: 3px;
  padding: 4px 10px;
  color: #ccc;
}
QToolButton#orientLandscape:checked, QToolButton#orientPortrait:checked {
  background-color: #0d66d0;
  border-color: #0d66d0;
  color: #fff;
}
QCheckBox { color: #ddd; spacing: 6px; }
QGroupBox {
  border: none;
  margin-top: 12px;
  color: #ccc;
  font-weight: 600;
}
QGroupBox::title { subcontrol-origin: margin; left: 0; padding: 0 4px; }
</string>
