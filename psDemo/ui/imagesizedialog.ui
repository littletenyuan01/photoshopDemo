   <string notr="true">QDialog#ImageSizeDialog {
  background-color: #323232;
  color: #e8e8e8;
}
QLabel { color: #e8e8e8; background: transparent; }
QLineEdit, QComboBox, QCheckBox {
  background-color: #3c3c3c;
  border: 1px solid #222;
  border-radius: 3px;
  padding: 3px 6px;
  color: #eee;
  min-height: 22px;
}
QCheckBox { border: none; background: transparent; }
QFrame#previewFrame {
  background-color: #2a2a2a;
  border: 1px solid #1a1a1a;
}
QPushButton#okButton {
  background-color: #0d66d0;
  color: #fff;
  border: none;
  border-radius: 3px;
  padding: 8px 22px;
  font-weight: 600;
}
QPushButton#okButton:hover { background-color: #1473e6; }
QPushButton#resetButton {
  background-color: #3a3a3a;
  color: #ddd;
  border: 1px solid #222;
  border-radius: 3px;
  padding: 8px 18px;
}
QToolButton#lockAspectButton {
  background: transparent;
  border: none;
  color: #aaa;
}
QToolButton#lockAspectButton:checked { color: #5eb0ff; }
</string>
