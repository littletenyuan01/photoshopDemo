  <property name="styleSheet">
   <string notr="true">QDialog#ColorPickerDialog {
  background-color: #464646;
  color: #eee;
}
QLabel {
  color: #e8e8e8;
  background: transparent;
}
QCheckBox {
  color: #e8e8e8;
  spacing: 6px;
}
QCheckBox::indicator {
  width: 13px;
  height: 13px;
  border: 1px solid #c8c8c8;
  border-radius: 2px;
  background-color: #2e2e2e;
}
QCheckBox::indicator:hover {
  border-color: #ffffff;
}
QCheckBox::indicator:checked {
  border: 1px solid #ffffff;
  background-color: #2e2e2e;
  image: url(:/icons/ui/check-white.png);
}
QRadioButton {
  color: #e8e8e8;
  spacing: 0px;
  background: transparent;
}
QRadioButton::indicator {
  width: 13px;
  height: 13px;
  margin: 0;
  border: 1px solid #c8c8c8;
  border-radius: 7px;
  background-color: #2e2e2e;
}
QRadioButton::indicator:hover {
  border-color: #ffffff;
}
QRadioButton::indicator:checked {
  border: 1px solid #ffffff;
  background-color: #2e2e2e;
  image: url(:/icons/ui/radio-dot-white.png);
}
QLineEdit {
  background-color: #2e2e2e;
  color: #f0f0f0;
  border: 1px solid #1a1a1a;
  border-radius: 2px;
  padding: 1px 4px;
  selection-background-color: #2d5a8a;
}
QPushButton {
  background-color: #5a5a5a;
  color: #eee;
  border: 1px solid #2a2a2a;
  border-radius: 4px;
  padding: 2px 8px;
}
QPushButton:hover { background-color: #6a6a6a; }
QPushButton:pressed { background-color: #404040; }</string>
