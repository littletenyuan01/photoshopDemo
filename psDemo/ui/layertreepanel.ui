  <property name="styleSheet">
   <string notr="true">QLabel { color: #d0d0d0; font-size: 11px; }
QComboBox {
  background-color: #2a2a2a; color: #eee; border: 1px solid #1a1a1a;
  border-radius: 2px; padding: 1px 4px; min-height: 20px; font-size: 11px;
}
QComboBox::drop-down { border: none; width: 16px; }
/* 弹出列表：白底黑字（对齐 PS 混合模式下拉观感） */
QComboBox QAbstractItemView {
  background-color: #ffffff; color: #222222;
  selection-background-color: #3875d7; selection-color: #ffffff;
  outline: 0; border: 1px solid #a0a0a0;
}
QComboBox QAbstractItemView::item { min-height: 22px; padding: 2px 8px; }
QComboBox QAbstractItemView::item:hover {
  background-color: #e5f1fb; color: #222222;
}
QComboBox QScrollBar:vertical {
  background: #f0f0f0; width: 10px; margin: 0;
}
QComboBox QScrollBar::handle:vertical {
  background: #c0c0c0; min-height: 24px; border-radius: 3px;
}
QComboBox QScrollBar::handle:vertical:hover { background: #a8a8a8; }
QComboBox QScrollBar::add-line:vertical,
QComboBox QScrollBar::sub-line:vertical { height: 0; border: none; }
QComboBox QScrollBar::add-page:vertical,
QComboBox QScrollBar::sub-page:vertical { background: #f0f0f0; }
QListWidget {
  background-color: #323232; color: #eee; border: none; outline: none; font-size: 12px;
}
QListWidget::item { padding: 4px 2px; min-height: 36px; }
QListWidget::item:selected { background-color: #555555; }
QListWidget::item:hover:!selected { background-color: #404040; }
QFrame#optionsHost, QFrame#toolbarHost { background-color: #3a3a3a; border: none; }
QFrame#toolbarHost { border-top: 1px solid #2a2a2a; }
QToolButton {
  background-color: transparent; color: #ddd; border: 1px solid transparent;
  border-radius: 2px; padding: 2px; font-size: 11px; min-width: 22px; min-height: 22px;
}
/* 底栏功能按钮：比筛选项更大，便于点按 */
QFrame#toolbarHost QToolButton {
  min-width: 30px; min-height: 30px; padding: 3px; border-radius: 3px;
}
QToolButton:hover { background-color: #4e4e4e; }
QToolButton:checked { background-color: #2d5a8a; border-color: #4a8ac0; }
QToolButton:disabled { color: #666; }</string>
