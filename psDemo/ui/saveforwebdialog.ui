  border-radius: 3px;
  padding: 8px 22px;
  font-weight: 600;
}
QPushButton#saveButton:hover { background-color: #1473e6; }
QPushButton#cancelButton {
  background-color: #3a3a3a;
  color: #ddd;
  border: 1px solid #222;
  border-radius: 3px;
  padding: 8px 18px;
}
</string>
